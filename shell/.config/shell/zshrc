#     eval "$(fzf --zsh)"
#     
#     # FZF-specific keybindings
#     bindkey '^T' fzf-file-widget      # Ctrl+T for files
#     bindkey '^R' fzf-history-widget   # Ctrl+R for history
# fi


# ===== Zsh Plugins =====
# Syntax highlighting
if [ -f $BREW_DIR/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source $BREW_DIR/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Enable menu selection for completion
zstyle ':completion:*' menu select

# Autosuggestions
if [ -f $BREW_DIR/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source $BREW_DIR/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'  # Dimmer suggestions
fi

# History substring search - enables prefix-based history navigation with up/down arrows
# This must be loaded after syntax highlighting and autosuggestions
if [ -f $BREW_DIR/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
    # Catppuccin-themed colors for history search highlights (Mocha palette)
    # FOUND: Catppuccin blue (#89b4fa) - when a matching command is found
    # NOT_FOUND: Catppuccin red (#f38ba8) - when no matching command exists
    # ZLE supports hex colors in the format bg=#RRGGBB,fg=#RRGGBB
    export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=#89b4fa,fg=#1e1e2e,bold'
    export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='bg=#f38ba8,fg=#1e1e2e,bold'
    
    source $BREW_DIR/share/zsh-history-substring-search/zsh-history-substring-search.zsh
    
    # Unbind default history navigation to ensure substring search takes precedence
    bindkey -r '^[[A'  # Unbind up arrow
    bindkey -r '^[[B'  # Unbind down arrow
    
    # Bind up and down arrow keys for history search
    # These bindings work with any number of characters (including 1)
    bindkey '^[[A' history-substring-search-up     # Up arrow
    bindkey '^[[B' history-substring-search-down   # Down arrow
    
    # Also bind in vi mode if you use it
    bindkey -M vicmd 'k' history-substring-search-up
    bindkey -M vicmd 'j' history-substring-search-down
fi

eval "$(mise activate zsh)"
