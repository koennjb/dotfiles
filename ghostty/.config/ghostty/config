# Ghostty Configuration

# ===== Font =====
font-family = JetBrainsMono Nerd Font
# font-family = 0xProto Nerd Font
font-size = 14
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic

# ===== Keybindings =====
# Tab navigation
keybind = ctrl+shift+]=next_tab
keybind = ctrl+shift+[=previous_tab

# Split panes
# Split vertically (new split to the right)
keybind = super+d=new_split:right
# Split horizontally (new split below)
keybind = super+e=new_split:down

# Pane navigation (VIM-style)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right

# ===== Visual Settings =====
# Make inactive panes more dimmed for better active pane indication
# Lower values = more dimmed (0.0 = fully transparent, 1.0 = fully opaque)
unfocused-split-opacity = 0.25
